[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%PuffyProvider%
DriverVer=08/18/2026,0.3.2.0
CatalogFile=PuffyVirtualAudio.cat
PnpLockDown=1

[Manufacturer]
%PuffyManufacturer%=PuffyModels,NTamd64.10.0...19041

[PuffyModels.NTamd64.10.0...19041]
%PuffyDeviceDescription%=PuffyVirtualAudio_Install,ROOT\PuffyVirtualAudio

[DestinationDirs]
DefaultDestDir=13
PuffyVirtualAudio_CopyFiles=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
PuffyVirtualAudio.sys=1

[PuffyVirtualAudio_Install.NT]
CopyFiles=PuffyVirtualAudio_CopyFiles

[PuffyVirtualAudio_CopyFiles]
PuffyVirtualAudio.sys

[PuffyVirtualAudio_Install.NT.Services]
AddService=PuffyVirtualAudio,0x00000002,PuffyVirtualAudio_Service

[PuffyVirtualAudio_Service]
DisplayName=%PuffyServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PuffyVirtualAudio.sys

[PuffyVirtualAudio_Install.NT.Wdf]
KmdfService=PuffyVirtualAudio,PuffyVirtualAudio_Wdf

[PuffyVirtualAudio_Wdf]
KmdfLibraryVersion=1.31

[PuffyVirtualAudio_Install.NT.Interfaces]
; Render endpoint used only by the Puffy desktop process as the transport sink.
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Transport%,PuffyTransport_Interface
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Transport%,PuffyTransport_Interface
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Transport%,PuffyTransport_Interface

; Public capture endpoint selectable by Discord, OBS, games and other clients.
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Microphone%,PuffyMicrophone_Interface
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Microphone%,PuffyMicrophone_Interface
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_Microphone%,PuffyMicrophone_Interface

[PuffyTransport_Interface]
AddReg=PuffyTransport_Interface.AddReg

[PuffyTransport_Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TransportFriendlyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[PuffyMicrophone_Interface]
AddReg=PuffyMicrophone_Interface.AddReg

[PuffyMicrophone_Interface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneFriendlyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[Strings]
PuffyProvider="Puffy"
PuffyManufacturer="Puffy"
PuffyDeviceDescription="Puffy Virtual Audio Cable"
PuffyServiceName="Puffy Virtual Audio"
DiskName="Puffy Virtual Audio installation media"
TransportFriendlyName="Puffy Virtual Microphone Transport"
MicrophoneFriendlyName="Puffy Virtual Microphone"

Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"

KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
KSNAME_Transport="Transport0"
KSNAME_Microphone="Microphone0"

PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
