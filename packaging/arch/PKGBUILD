# Maintainer: puffy contributors
pkgname=puffy
pkgver=0.1.0
pkgrel=1
pkgdesc='Cute cross-platform soundboard and real-time microphone mixer'
arch=('x86_64')
url='https://github.com/Yreemali/Puffy'
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'sqlite' 'libsndfile' 'pipewire' 'libx11' 'libxtst')
makedepends=('cmake' 'ninja' 'git')
source=('puffy::git+https://github.com/Yreemali/Puffy.git#branch=main')
sha256sums=('SKIP')

build() {
    cmake -S "$srcdir/puffy" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DPUFFY_BUILD_DESKTOP=ON \
        -DPUFFY_BUILD_TESTS=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$srcdir/puffy/packaging/arch/puffy.desktop" \
        "$pkgdir/usr/share/applications/puffy.desktop"
    install -Dm644 "$srcdir/puffy/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
