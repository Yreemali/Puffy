{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "puffy",
  "version": "0.2.0",
  "identifier": "dev.puffy.soundboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "puffy — soundboard",
      "width": 1280,
      "height": 800,
      "minWidth": 900,
      "minHeight": 600,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "visible": true,
      "decorations": true,
      "focus": true,
      "transparent": false
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "AudioVideo",
    "shortDescription": "Modern soundboard and realtime microphone mixer",
    "icon": ["icons/icon.png", "icons/puffy.svg"],
    "resources": ["../../../build-native-check/libpuffy_native.so"]
  }
}
